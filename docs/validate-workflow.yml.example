name: Validate plugin
on:
  push:
  pull_request:
permissions:
  contents: read
jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: python -m pip install PyYAML==6.0.3 jsonschema==4.26.0
      - run: python scripts/validate_and_package.py --negative-tests --output dist
      - uses: actions/upload-artifact@v4
        with:
          name: career-optimizer-plugin
          path: dist/
